# Copy to .env for local runs. Never commit .env. Values are intentionally empty here.
METACULUS_TOKEN=
OPENROUTER_API_KEY=

# Profile: cheap (default, small model, 2 draws) or full (frontier model, 3 draws)
BOT_PROFILE=
# Spending caps in dollars (defaults 1 per run, 55 for the season; 0 = no cap)
BOT_MAX_USD_PER_RUN=
BOT_MAX_USD_TOTAL=

# Optional overrides
BOT_MODEL=
BOT_RESEARCH_MODEL=
BOT_PARSER_MODEL=
BOT_USD_PER_MTOK_INPUT=
BOT_USD_PER_MTOK_OUTPUT=
BOT_USD_PER_SEARCH=
BOT_MAX_ATTEMPTS_PER_QUESTION=
BOT_RUN_SECONDS=
BOT_LEDGER_PATH=
PREDICTIONS_PER_QUESTION=
MAX_QUESTIONS_PER_RUN=
LLM_TIMEOUT_SECONDS=
LLM_MAX_TOKENS=

# Other provider instead of OpenRouter (model named openai/<model> or anthropic/<model>)
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
